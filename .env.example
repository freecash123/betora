# Environment Variables
# Copy to .env and fill in your values

# ── App ──
NODE_ENV=development
PORT=4000
DEMO_MODE=true
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database ──
DATABASE_URL=postgresql://betora:betora@localhost:5432/betora

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie ──
COOKIE_SECRET=change-this-cookie-secret

# ── CORS ──
CORS_ORIGINS=http://localhost:3000

# ── Encryption ──
ENCRYPTION_KEY=change-this-32-character-key!!!!

# ── Email (SMTP) ──
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@betora.com

# ── Storage (S3-Compatible) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=betora-uploads

# ── Sports Data Provider ──
SPORTS_DATA_PROVIDER=demo
SPORTS_DATA_API_KEY=
SPORTS_DATA_API_URL=

# ── Payment Provider ──
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── KYC Provider ──
KYC_PROVIDER=demo
KYC_API_KEY=
KYC_API_URL=

# ── WebSocket ──
WS_PORT=4001